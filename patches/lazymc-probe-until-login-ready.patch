-    // Connect to server, record Forge payload
-    let forge_payload = connect_to_server(&config, &server).await?;
-    *server.forge_payload.write().await = forge_payload;
+    // Status can come online before Forge accepts logins. Keep trying until
+    // login probing reaches a real ready state or the overall probe timeout is
+    // exhausted.
+    let deadline = Instant::now() + PROBE_ONLINE_TIMEOUT;
+    loop {
+        // Connect to server, record Forge payload
+        match connect_to_server(&config, &server).await {
+            Ok(forge_payload) => {
+                *server.forge_payload.write().await = forge_payload;
+                return Ok(());
+            }
+            Err(_) if Instant::now() < deadline => {
+                warn!(
+                    target: "lazymc::probe",
+                    "Server answered status but is not ready for login probe yet, retrying..."
+                );
+                time::sleep(Duration::from_secs(5)).await;
+            }
+            Err(_) => {
+                error!(target: "lazymc::probe", "Probe timed out waiting for server login readiness");
+                return Err(());
+            }
+        }
+    }
 
-    Ok(())
 }
 
