{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": "-- Grafana --",
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 3 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "sum((1 - probe_success{job=~\"blackbox_.*\"}) > 0)",
          "instant": true,
          "legendFormat": "failed",
          "refId": "A"
        }
      ],
      "title": "Failed Probes (Now)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "up{job=\"node\",instance=\"zues\"}",
          "instant": true,
          "legendFormat": "zues node",
          "refId": "A"
        }
      ],
      "title": "Node Exporter (zues)",
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "up{job=\"unbound\"}",
          "instant": true,
          "legendFormat": "unbound",
          "refId": "A"
        }
      ],
      "title": "Unbound Exporter", 
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "expr": "up{job=\"blackbox_tcp\",instance=\"turn.nixlab.au:3478\"}",
          "instant": true,
          "legendFormat": "coturn tcp",
          "refId": "A"
        }
      ],
      "title": "Coturn Probe", 
      "type": "stat"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "id": 5,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "probe_success{job=\"blackbox_http\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ],
      "title": "HTTP Probe Success by Target",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "id": 6,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{job=~\"blackbox_.*\"}",
          "legendFormat": "{{job}} {{instance}}",
          "refId": "A"
        }
      ],
      "title": "Probe Duration",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "id": 7,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum by (device) (rate(node_network_receive_bytes_total{job=\"node\",instance=\"zues\",device!~\"lo|veth.*|docker.*|br.*\"}[5m]))",
          "legendFormat": "{{device}} rx",
          "refId": "A"
        },
        {
          "expr": "sum by (device) (rate(node_network_transmit_bytes_total{job=\"node\",instance=\"zues\",device!~\"lo|veth.*|docker.*|br.*\"}[5m]))",
          "legendFormat": "{{device}} tx",
          "refId": "B"
        }
      ],
      "title": "Interface Throughput (zues)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "pps"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "id": 8,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum by (device) (rate(node_network_receive_drop_total{job=\"node\",instance=\"zues\",device!~\"lo|veth.*|docker.*|br.*\"}[5m]))",
          "legendFormat": "{{device}} rx drop",
          "refId": "A"
        },
        {
          "expr": "sum by (device) (rate(node_network_transmit_drop_total{job=\"node\",instance=\"zues\",device!~\"lo|veth.*|docker.*|br.*\"}[5m]))",
          "legendFormat": "{{device}} tx drop",
          "refId": "B"
        },
        {
          "expr": "sum by (device) (rate(node_network_receive_errs_total{job=\"node\",instance=\"zues\",device!~\"lo|veth.*|docker.*|br.*\"}[5m]) + rate(node_network_transmit_errs_total{job=\"node\",instance=\"zues\",device!~\"lo|veth.*|docker.*|br.*\"}[5m]))",
          "legendFormat": "{{device}} errors",
          "refId": "C"
        }
      ],
      "title": "Interface Drops and Errors (zues)",
      "type": "timeseries"
    },
    {
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 21 },
      "id": 9,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "rate(node_netstat_Tcp_RetransSegs{job=\"node\",instance=\"zues\"}[5m])",
          "legendFormat": "tcp retransmits",
          "refId": "A"
        },
        {
          "expr": "rate(node_netstat_Tcp_InErrs{job=\"node\",instance=\"zues\"}[5m])",
          "legendFormat": "tcp in errs",
          "refId": "B"
        }
      ],
      "title": "TCP Health (zues)",
      "type": "timeseries"
    },
    {
      "datasource": "Loki",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 29 },
      "id": 10,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum by (host) (count_over_time({job=\"systemd-journal\",unit=\"NetworkManager.service\"} |~ \"(?i)(disconnect|carrier|link.*down|dhcp|timed out|failed)\" [5m]))",
          "legendFormat": "{{host}} networkmanager incidents",
          "refId": "A"
        },
        {
          "expr": "sum by (host) (count_over_time({job=\"systemd-journal\",unit=~\"cloudflared-tunnel-.*.service\"} |~ \"(?i)(error|fail|timeout|reconnect)\" [5m]))",
          "legendFormat": "{{host}} cloudflared incidents",
          "refId": "B"
        }
      ],
      "title": "Network Service Incident Rate",
      "type": "timeseries"
    },
    {
      "datasource": "Loki",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 29 },
      "id": 11,
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum by (host) (count_over_time({job=\"systemd-journal\",host=\"leo\"} |~ \"(?i)(caelestia|quickshell)\" |~ \"(?i)(crash|restart|failed|segfault)\" [5m]))",
          "legendFormat": "{{host}} shell restarts",
          "refId": "A"
        },
        {
          "expr": "sum by (host) (count_over_time({job=\"systemd-journal\",host=\"leo\",unit=\"NetworkManager.service\"} |~ \"(?i)(disconnect|carrier|dhcp|timeout|failed)\" [5m]))",
          "legendFormat": "{{host}} nm incidents",
          "refId": "B"
        }
      ],
      "title": "Leo Shell vs Network Incident Correlation",
      "type": "timeseries"
    },
    {
      "datasource": "Loki",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 37 },
      "id": 12,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "expr": "{job=\"systemd-journal\",host=~\"leo|zues\",unit=~\"NetworkManager.service|cloudflared-tunnel-.*.service\"} |~ \"(?i)(disconnect|carrier|timeout|failed|error|reconnect)\"",
          "refId": "A"
        }
      ],
      "title": "Recent Network-Related Logs (leo/zues)",
      "type": "logs"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["homelab", "network", "incidents"],
  "templating": {
    "list": [
      {
        "name": "host",
        "type": "query",
        "datasource": "Prometheus",
        "definition": "label_values(up, instance)",
        "query": {
          "query": "label_values(up, instance)",
          "refId": "network-host"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "Network Incidents",
  "uid": "network-incidents",
  "version": 1,
  "weekStart": ""
}
