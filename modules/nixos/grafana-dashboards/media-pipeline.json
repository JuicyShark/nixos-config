{
  "annotations": {"list": [{"builtIn": 1, "datasource": "-- Grafana --", "enable": true, "hide": true, "iconColor": "rgba(0, 211, 255, 1)", "name": "Annotations & Alerts", "type": "dashboard"}]},
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Jellyfin Sessions",
      "datasource": "Prometheus",
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(jellyfin_active)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Deluge Download Rate",
      "datasource": "Prometheus",
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "sum(deluge_download_rate_bytes)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Deluge Upload Rate",
      "datasource": "Prometheus",
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum(deluge_upload_rate_bytes)", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"colorMode": "value", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Media Jobs Up",
      "datasource": "Prometheus",
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "sum(up{job=~\"sonarr|radarr|lidarr|prowlarr|deluge\"})", "instant": true, "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": 0}, {"color": "green", "value": 1}]}, "color": {"mode": "thresholds"}, "unit": "short"}, "overrides": []},
      "options": {"colorMode": "background", "graphMode": "none", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Deluge Transfer",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "targets": [
        {"expr": "sum(deluge_download_rate_bytes)", "legendFormat": "download", "refId": "A"},
        {"expr": "sum(deluge_upload_rate_bytes)", "legendFormat": "upload", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "Bps", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Jellyfin Session Trend",
      "datasource": "Prometheus",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "targets": [{"expr": "sum(jellyfin_active)", "legendFormat": "sessions", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Arr/Deluge Errors (Logs)",
      "datasource": "Loki",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 13},
      "targets": [
        {"expr": "sum by (unit) (count_over_time({job=\"systemd-journal\",unit=~\"sonarr.service|radarr.service|lidarr.service|prowlarr.service|deluged.service|deluge-web.service\"} |~ \"(?i)(error|failed|exception|timeout)\" [5m]))", "legendFormat": "{{unit}}", "refId": "A"}
      ],
      "fieldConfig": {"defaults": {"unit": "short", "color": {"mode": "palette-classic"}}, "overrides": []},
      "options": {"legend": {"displayMode": "list", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "none"}}
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["homelab", "media"],
  "templating": {"list": [{"name": "job", "type": "query", "datasource": "Prometheus", "definition": "label_values(up, job)", "query": {"query": "label_values(up, job)", "refId": "job"}, "includeAll": true, "multi": true, "current": {"selected": true, "text": "All", "value": "$__all"}}]},
  "time": {"from": "now-24h", "to": "now"},
  "timezone": "browser",
  "title": "Media Pipeline",
  "uid": "media-pipeline",
  "version": 1,
  "weekStart": ""
}
