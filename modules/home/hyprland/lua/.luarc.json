{
  "$schema": "https://raw.githubusercontent.com/sumneko/vscode-lua/master/setting/schema.json",
  "runtime": {
    "version": "LuaJIT"
  },
  "diagnostics": {
    "globals": [
      "cfg",
      "hl"
    ],
    "disable": [
      "lowercase-global",
      "duplicate-set-field"
    ],
    "neededFileStatus": {
      "ambiguity-1": "Any",
      "circle-doc-class": "Any",
      "lowercase-global": "None"
    }
  },
  "workspace": {
    "checkThirdParty": false,
    "library": []
  },
  "telemetry": {
    "enable": false
  }
}
