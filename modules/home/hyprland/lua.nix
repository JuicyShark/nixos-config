{
  cfg,
  lib,
}: let
  inherit (lib) concatMapStringsSep concatStringsSep listToAttrs nameValuePair;

  luaString = s:
    "\""
    + (builtins.replaceStrings
      ["\\" "\"" "\n" "\r" "\t"]
      ["\\\\" "\\\"" "\\n" "\\r" "\\t"]
      s)
    + "\"";

  # ---- Render a Nix value as a Lua literal expression ----
  toLua = v:
    if v == null
    then "nil"
    else if builtins.isBool v
    then
      if v
      then "true"
      else "false"
    else if builtins.isInt v || builtins.isFloat v
    then toString v
    else if builtins.isString v
    then luaString v
    else if builtins.isList v
    then "{" + concatStringsSep ", " (map toLua v) + "}"
    else if builtins.isAttrs v
    then
      "{"
      + concatStringsSep ", " (map
        (k: let
          val = v.${k};
          key =
            if builtins.match "[a-zA-Z_][a-zA-Z0-9_]*" k != null
            then k
            else "[${luaString k}]";
        in "${key} = ${toLua val}")
        (builtins.attrNames v))
      + "}"
    else throw "toLua: unsupported value: ${builtins.toJSON v}";

  initModule =
    ''
      -- Hyprland 0.55+ Lua config. See:
      --   https://github.com/hyprwm/Hyprland/blob/main/example/hyprland.lua
      --   https://github.com/hyprwm/Hyprland/blob/main/meta/hl.meta.lua
      -- This file is generated by modules/home/hyprland/lua.nix. The local Lua
      -- modules live under modules/home/hyprland/lua/.

      local cfg = ${toLua cfg}
      local ctx = { hl = hl, cfg = cfg }
    ''
    + concatMapStringsSep "\n" (name: ''
      require(${luaString name})(ctx)
    '')
    moduleNames;

  # Each file returns function(ctx), then the generated config executes it.
  # Order is still meaningful: desktop and commands define local policy tables,
  # cheatsheet tracks sidecar state, bind-helpers decorates direct hl.bind calls,
  # cheatsheet.events follows compositor submap truth, runtime modules register
  # event handlers, binds registers top-level shortcuts, and binds/submaps
  # consumes the helper-domain modules.
  initModules = [
    {
      name = "desktop";
      path = "desktop.lua";
    }
    {
      name = "commands";
      path = "commands.lua";
    }
    {
      name = "cheatsheet";
      path = "cheatsheet.lua";
    }
    {
      name = "bind-helpers";
      path = "bind-helpers.lua";
    }
    {
      name = "workspace-layout";
      path = "workspace-layout.lua";
    }
    {
      name = "cheatsheet.events";
      path = "cheatsheet/events.lua";
    }
    {
      name = "window-state";
      path = "window-state.lua";
    }
    {
      name = "special-apps";
      path = "special-apps.lua";
    }
    {
      name = "external-monitor-workspaces";
      path = "external-monitor-workspaces.lua";
    }
    {
      name = "smart-focus";
      path = "smart-focus.lua";
    }
    {
      name = "rules";
      path = "rules.lua";
    }
    {
      name = "hyprbars";
      path = "hyprbars.lua";
    }
    {
      name = "special-workspaces";
      path = "special-workspaces.lua";
    }
    {
      name = "sunshine";
      path = "sunshine.lua";
    }
    {
      name = "autostart";
      path = "autostart.lua";
    }
    {
      name = "binds";
      path = "binds.lua";
    }
    {
      name = "binds.submaps";
      path = "binds/submaps.lua";
    }
  ];

  optionalModules = [
    {
      name = "binds.groups";
      path = "binds/groups.lua";
    }
    {
      name = "binds.layouts.master";
      path = "binds/layouts/master.lua";
    }
    {
      name = "binds.layouts.dwindle";
      path = "binds/layouts/dwindle.lua";
    }
    {
      name = "binds.layouts.scrolling";
      path = "binds/layouts/scrolling.lua";
    }
    {
      name = "binds.submaps.core";
      path = "binds/submaps/core.lua";
    }
    {
      name = "binds.submaps.emacs";
      path = "binds/submaps/emacs.lua";
    }
    {
      name = "binds.submaps.tmux";
      path = "binds/submaps/tmux.lua";
    }
  ];

  modules = initModules ++ optionalModules;

  moduleNames = map (module: module.name) initModules;
  moduleFile = module:
    nameValuePair module.name {
      content = ./lua + "/${module.path}";
      autoLoad = false;
    };
in
  {
    "00-init" = {
      content = initModule;
      autoLoad = true;
    };
  }
  // listToAttrs (map moduleFile modules)
